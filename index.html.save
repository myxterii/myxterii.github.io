<!DOCTYPE html>
<html lang="en">
	<head>
<title>myxterii</title>


<style>
.main {
  background-color: #392F5A;
  color: #ff8243;
  border: 2px solid black; /*ill add more here later */
  margin: 20px;
  padding: 20px;
}
@font-face {
    font-family: 'Oceanside';
    src: url('fonts/Oceanside Typewriter.ttf') format('truetype');
    font-weight: normal;
    font-style: normal;
}
p{
font-family:Oceanside;
}

.striped-divider {
    width: 100%;
    height: 24px; 
    border: 2px solid #ff8243;
    border-radius: 0; 
    box-sizing: border-box;
    background: repeating-linear-gradient(
        45deg,
        #ff8243,
        #ff8243, 12px,
        #f4d06f 12px,
        #f4d06f 24px
    );
    background-size: 34px 34px;
    animation: moveStripes 4.0s linear infinite; 
}

@keyframes moveStripes {
    from {
        background-position: 0 0;
    }
    to {
        background-position: 34px 0;
    }
} /*these are the stripes. end*/

.top-master-banner {
    width: 100%;
    height: 200px; 
    background-color: #f4d06f;
    border-radius: 0; 
    overflow: hidden;
    border: 2px solid #ff8243;
    box-sizing: border-box;
}

.top-master-banner img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}/*big banner*/
</style>


	</head>
		<body>
	<div class="main" >
<!-- img banner here -->
 <div class="top-master-banner"></div><br>

<!-- striped divider -->
 <div class="striped-divider"></div>

<!-- (img) left hand side. to the right theres info-->

 <!-- striped divider-->
	<p>welcome to my website<br>meow<br>i thought this would be a lot different. but its okay!<br>im going to do things with this eventually</p>
  <div class="striped-divider"></div>
	</div>
  
		</body>
</html>
